<!-- Icons are addressed as :/icons/<name>.svg regardless of which set they
     come from (lucide/tabler/material/custom subdirectories) — the alias
     flattens the path so Icons::get("name") stays source-agnostic.
     Every file listed here needs a row in ASSETS_LICENSES.md (CI-enforced). -->
<RCC>
  <qresource prefix="/icons">
    <file alias="box.svg">icons/lucide/box.svg</file>
    <file alias="circle-plus.svg">icons/lucide/circle-plus.svg</file>
    <file alias="git-merge.svg">icons/lucide/git-merge.svg</file>
    <file alias="file-output.svg">icons/lucide/file-output.svg</file>
    <file alias="file-plus.svg">icons/lucide/file-plus.svg</file>
    <file alias="file.svg">icons/lucide/file.svg</file>
    <file alias="folder.svg">icons/lucide/folder.svg</file>
    <file alias="folder-open.svg">icons/lucide/folder-open.svg</file>
    <file alias="image.svg">icons/lucide/image.svg</file>
    <file alias="info.svg">icons/lucide/info.svg</file>
    <file alias="magnet.svg">icons/lucide/magnet.svg</file>
    <file alias="mountain.svg">icons/lucide/mountain.svg</file>
    <file alias="mouse-pointer-2.svg">icons/lucide/mouse-pointer-2.svg</file>
    <file alias="move.svg">icons/lucide/move.svg</file>
    <file alias="octagon-x.svg">icons/lucide/octagon-x.svg</file>
    <file alias="redo-2.svg">icons/lucide/redo-2.svg</file>
    <file alias="rotate-ccw.svg">icons/lucide/rotate-ccw.svg</file>
    <file alias="save.svg">icons/lucide/save.svg</file>
    <file alias="scan.svg">icons/lucide/scan.svg</file>
    <file alias="scissors.svg">icons/lucide/scissors.svg</file>
    <file alias="trash-2.svg">icons/lucide/trash-2.svg</file>
    <file alias="trees.svg">icons/lucide/trees.svg</file>
    <file alias="triangle-alert.svg">icons/lucide/triangle-alert.svg</file>
    <file alias="undo-2.svg">icons/lucide/undo-2.svg</file>
    <file alias="waypoints.svg">icons/lucide/waypoints.svg</file>
    <file alias="chevrons-right.svg">icons/custom/chevrons-right.svg</file>
    <file alias="clothoid-road.svg">icons/custom/clothoid-road.svg</file>
    <file alias="corner-radius.svg">icons/custom/corner-radius.svg</file>
    <file alias="stop-line.svg">icons/custom/stop-line.svg</file>
    <file alias="junction-span.svg">icons/custom/junction-span.svg</file>
    <file alias="junction-surface.svg">icons/custom/junction-surface.svg</file>
    <file alias="surface-nodes.svg">icons/custom/surface-nodes.svg</file>
    <file alias="terrain-brush.svg">icons/custom/terrain-brush.svg</file>
    <file alias="maneuver.svg">icons/custom/tool_maneuver.svg</file>
    <file alias="signal.svg">icons/custom/tool_signal.svg</file>
    <file alias="sign.svg">icons/custom/tool_sign.svg</file>
    <file alias="crosswalk.svg">icons/custom/crosswalk.svg</file>
    <file alias="junction-connect.svg">icons/custom/junction-connect.svg</file>
    <file alias="lane-section.svg">icons/custom/lane-section.svg</file>
    <file alias="marking-point.svg">icons/custom/marking-point.svg</file>
    <file alias="marking-curve.svg">icons/custom/marking-curve.svg</file>
    <file alias="prop-point.svg">icons/custom/prop-point.svg</file>
    <file alias="prop-curve.svg">icons/custom/prop-curve.svg</file>
    <file alias="prop-span.svg">icons/custom/prop-span.svg</file>
    <file alias="prop-polygon.svg">icons/custom/prop-polygon.svg</file>
    <file alias="template-highway.svg">icons/custom/template-highway.svg</file>
    <file alias="template-local.svg">icons/custom/template-local.svg</file>
    <file alias="template-rural.svg">icons/custom/template-rural.svg</file>
    <file alias="template-urban.svg">icons/custom/template-urban.svg</file>
  </qresource>
  <!-- Full-colour application icon (coral robot). Multi-size so QIcon picks a
       crisp raster for the window/taskbar at any scale; the macOS Dock uses the
       bundled .icns and Windows the .rc/.ico instead. -->
  <!-- Runtime library catalogue (UI-revamp Phase 2): the manifest the Library
       panel loads. Aliased from the committed data file so there is one copy;
       manifest.json is license-exempt (machinery, not an asset). -->
  <qresource prefix="/library">
    <file alias="manifest.json">../../assets/library/manifest.json</file>
    <!-- Library item thumbnails (p6-s2), generated by
         scripts/gen_library_thumbnails.py; rows in ASSETS_LICENSES.md. Aliased
         as thumbnails/<name>.png so LibraryListModel resolves :/library/... -->
    <file alias="thumbnails/road_prawko_urban.png">../../assets/library/thumbnails/road_prawko_urban.png</file>
    <file alias="thumbnails/style_prawko_urban.png">../../assets/library/thumbnails/style_prawko_urban.png</file>
    <file alias="thumbnails/road_prawko_wide.png">../../assets/library/thumbnails/road_prawko_wide.png</file>
    <file alias="thumbnails/style_prawko_wide.png">../../assets/library/thumbnails/style_prawko_wide.png</file>
    <file alias="thumbnails/road_prawko_promenade.png">../../assets/library/thumbnails/road_prawko_promenade.png</file>
    <file alias="thumbnails/style_prawko_promenade.png">../../assets/library/thumbnails/style_prawko_promenade.png</file>
    <file alias="thumbnails/road_prawko_one_side.png">../../assets/library/thumbnails/road_prawko_one_side.png</file>
    <file alias="thumbnails/style_prawko_one_side.png">../../assets/library/thumbnails/style_prawko_one_side.png</file>
    <file alias="thumbnails/road_prawko_parking.png">../../assets/library/thumbnails/road_prawko_parking.png</file>
    <file alias="thumbnails/style_prawko_parking.png">../../assets/library/thumbnails/style_prawko_parking.png</file>
    <file alias="thumbnails/road_prawko_no_curb.png">../../assets/library/thumbnails/road_prawko_no_curb.png</file>
    <file alias="thumbnails/style_prawko_no_curb.png">../../assets/library/thumbnails/style_prawko_no_curb.png</file>
  </qresource>
  <!-- Surface textures (CC0, Poly Haven) for the textured render mode: albedo +
       normal (nor_gl, PNG — lossless) + roughness maps. Aliased from the
       committed, re-encoded files; rows in ASSETS_LICENSES.md. -->
  <qresource prefix="/textures">
    <file alias="asphalt.jpg">../../assets/textures/prawko_atlas/asphalt_diff_2048.jpg</file>
    <file alias="asphalt_nor.png">../../assets/textures/prawko_atlas/asphalt_nor_gl_1024.png</file>
    <file alias="asphalt_rough.jpg">../../assets/textures/prawko_atlas/asphalt_rough_1024.jpg</file>
    <file alias="asphalt_worn.jpg">../../assets/textures/asphalt/worn_asphalt_diff_512.jpg</file>
    <file alias="asphalt_worn_nor.png">../../assets/textures/asphalt/worn_asphalt_nor_gl_512.png</file>
    <file alias="asphalt_worn_rough.jpg">../../assets/textures/asphalt/worn_asphalt_rough_512.jpg</file>
    <file alias="concrete.jpg">../../assets/textures/prawko_atlas/concrete_diff_2048.jpg</file>
    <file alias="concrete_nor.png">../../assets/textures/prawko_atlas/concrete_nor_gl_1024.png</file>
    <file alias="concrete_rough.jpg">../../assets/textures/prawko_atlas/concrete_rough_1024.jpg</file>
  </qresource>
  <qresource prefix="/branding">
    <file alias="icon_16.png">branding/icon_16.png</file>
    <file alias="icon_24.png">branding/icon_24.png</file>
    <file alias="icon_32.png">branding/icon_32.png</file>
